{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "contradiction-register.schema.json",
  "type": "object",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "contradiction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^contradiction-[A-Za-z0-9._-]+$"
        },
        "topic": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sources": {
          "$ref": "#/$defs/stringArray"
        },
        "claims": {
          "$ref": "#/$defs/stringArray"
        },
        "impact": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "confidence": {
          "enum": [
            "unknown",
            "low",
            "medium",
            "high"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "proposed_resolution": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "open",
            "under-review",
            "resolved",
            "accepted-risk",
            "rejected"
          ]
        }
      },
      "required": [
        "id",
        "topic",
        "sources",
        "claims",
        "impact",
        "confidence",
        "owner",
        "proposed_resolution",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "contradictions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    }
  },
  "required": [
    "framework_version",
    "contradictions"
  ],
  "additionalProperties": false
}
