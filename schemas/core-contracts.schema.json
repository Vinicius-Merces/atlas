{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Core Contracts Manifest",
  "type": "object",
  "required": [
    "version",
    "stability",
    "canonical_runtime",
    "contracts",
    "canonical_paths"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "enum": [
        "alpha",
        "beta",
        "rc",
        "stable"
      ]
    },
    "canonical_runtime": {
      "type": "string",
      "minLength": 1
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "canonical_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
