{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Agent Metadata",
  "type": "object",
  "required": [
    "name",
    "description",
    "model"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "tools": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$"
    }
  },
  "additionalProperties": false
}
