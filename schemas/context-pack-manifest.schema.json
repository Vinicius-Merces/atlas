{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Context Pack Manifest",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "context_pack": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "source_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "missing_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "selection": {
      "type": "string",
      "minLength": 1
    },
    "deferred_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "truncated_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stable_prefix_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "stable_prefix_chars": {
      "type": "integer",
      "minimum": 0
    },
    "rendered_chars": {
      "type": "integer",
      "minimum": 0
    },
    "max_total_chars": {
      "type": "integer",
      "minimum": 0
    },
    "measurement_unit": {
      "const": "characters"
    }
  },
  "required": [
    "task_id",
    "context_pack",
    "sources"
  ],
  "additionalProperties": false
}
