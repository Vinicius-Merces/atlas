{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Registry",
  "type": "object",
  "required": [
    "version",
    "orchestrator",
    "agents",
    "contracts",
    "workflows"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "orchestrator": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
