{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Registry",
  "type": "object",
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "slugArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "pathCatalog": {
      "type": "object",
      "description": "Extensible registry namespace whose named capabilities resolve to canonical repository paths or mappings.",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtimeSupport": {
      "type": "object",
      "properties": {
        "release_channel": {
          "enum": [
            "alpha",
            "beta",
            "rc",
            "stable"
          ]
        },
        "status": {
          "enum": [
            "experimental",
            "beta-supported",
            "supported",
            "deprecated",
            "unsupported"
          ]
        },
        "canonical_runtime": {
          "$ref": "#/$defs/slug"
        },
        "supported_runtimes": {
          "$ref": "#/$defs/slugArray"
        },
        "experimental_adapters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        },
        "codex_synchronization": {
          "enum": [
            "generated",
            "manual"
          ]
        },
        "runtime_sync_policy": {
          "type": "string",
          "minLength": 1
        },
        "runtime_parity_matrix": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "release_channel",
        "status",
        "canonical_runtime",
        "supported_runtimes",
        "experimental_adapters",
        "codex_synchronization",
        "runtime_sync_policy",
        "runtime_parity_matrix"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "orchestrator",
    "agents",
    "contracts",
    "workflows",
    "skills",
    "reviews",
    "commands",
    "memory",
    "operations",
    "trust",
    "experience",
    "platform",
    "enterprise",
    "automation",
    "adoption",
    "assurance",
    "stability",
    "runtime_support",
    "runtime_contract",
    "executable_runtime",
    "execution_continuity",
    "parallel_execution",
    "portable_memory",
    "memory_governance",
    "evidence_and_provenance",
    "policy_enforcement",
    "release_engineering"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "orchestrator": {
      "$ref": "#/$defs/slug"
    },
    "agents": {
      "$ref": "#/$defs/slugArray"
    },
    "contracts": {
      "$ref": "#/$defs/slugArray"
    },
    "skills": {
      "$ref": "#/$defs/slugArray"
    },
    "reviews": {
      "$ref": "#/$defs/slugArray"
    },
    "workflows": {
      "$ref": "#/$defs/slugArray"
    },
    "commands": {
      "$ref": "#/$defs/slugArray"
    },
    "memory": {
      "$ref": "#/$defs/pathCatalog"
    },
    "operations": {
      "$ref": "#/$defs/pathCatalog"
    },
    "trust": {
      "$ref": "#/$defs/pathCatalog"
    },
    "experience": {
      "$ref": "#/$defs/pathCatalog"
    },
    "platform": {
      "$ref": "#/$defs/pathCatalog"
    },
    "enterprise": {
      "$ref": "#/$defs/pathCatalog"
    },
    "automation": {
      "$ref": "#/$defs/pathCatalog"
    },
    "adoption": {
      "$ref": "#/$defs/pathCatalog"
    },
    "assurance": {
      "$ref": "#/$defs/pathCatalog"
    },
    "stability": {
      "$ref": "#/$defs/pathCatalog"
    },
    "runtime_support": {
      "$ref": "#/$defs/runtimeSupport"
    },
    "runtime_contract": {
      "$ref": "#/$defs/pathCatalog"
    },
    "executable_runtime": {
      "$ref": "#/$defs/pathCatalog"
    },
    "execution_continuity": {
      "$ref": "#/$defs/pathCatalog"
    },
    "parallel_execution": {
      "$ref": "#/$defs/pathCatalog"
    },
    "portable_memory": {
      "$ref": "#/$defs/pathCatalog"
    },
    "memory_governance": {
      "$ref": "#/$defs/pathCatalog"
    },
    "evidence_and_provenance": {
      "$ref": "#/$defs/pathCatalog"
    },
    "policy_enforcement": {
      "$ref": "#/$defs/pathCatalog"
    },
    "release_engineering": {
      "$ref": "#/$defs/pathCatalog"
    }
  },
  "additionalProperties": false
}
