{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "parallel-execution-manifest.schema.json",
  "type": "object",
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "workstream": {
      "type": "object",
      "properties": {
        "workstream_id": {
          "type": "string",
          "pattern": "^ws-[A-Za-z0-9._-]+$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^task-[A-Za-z0-9._-]+$"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "owner_role": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "$ref": "#/$defs/stringArray"
        },
        "resource_claims": {
          "$ref": "#/$defs/stringArray"
        },
        "validation": {
          "$ref": "#/$defs/stringArray"
        },
        "reviews": {
          "$ref": "#/$defs/stringArray"
        },
        "completion_criteria": {
          "$ref": "#/$defs/stringArray"
        },
        "changed_files": {
          "$ref": "#/$defs/stringArray"
        },
        "remaining_risks": {
          "$ref": "#/$defs/stringArray"
        },
        "status": {
          "enum": [
            "planned",
            "in-progress",
            "completed",
            "partial",
            "blocked",
            "failed"
          ]
        }
      },
      "required": [
        "workstream_id",
        "task_id",
        "summary",
        "runtime",
        "owner_role",
        "dependencies",
        "resource_claims",
        "validation",
        "reviews",
        "completion_criteria",
        "status"
      ],
      "additionalProperties": false
    },
    "claim": {
      "type": "object",
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-[A-Za-z0-9._-]+$"
        },
        "workstream_id": {
          "type": "string",
          "pattern": "^ws-[A-Za-z0-9._-]+$"
        },
        "mode": {
          "enum": [
            "shared",
            "exclusive"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "claim_id",
        "workstream_id",
        "mode",
        "resources",
        "reason"
      ],
      "additionalProperties": false
    },
    "conflict": {
      "type": "object",
      "properties": {
        "left_claim": {
          "type": "string",
          "pattern": "^claim-[A-Za-z0-9._-]+$"
        },
        "right_claim": {
          "type": "string",
          "pattern": "^claim-[A-Za-z0-9._-]+$"
        },
        "resource_left": {
          "type": "string",
          "minLength": 1
        },
        "resource_right": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "const": "blocking"
        }
      },
      "required": [
        "left_claim",
        "right_claim",
        "resource_left",
        "resource_right",
        "severity"
      ],
      "additionalProperties": false
    }
  },
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^task-[A-Za-z0-9._-]+$"
    },
    "workstreams": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/workstream"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "dependencies": {
      "$ref": "#/$defs/stringArray"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "status": {
      "enum": [
        "planned",
        "in-progress",
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    }
  },
  "required": [
    "task_id",
    "workstreams",
    "claims",
    "dependencies",
    "status"
  ],
  "additionalProperties": false
}
