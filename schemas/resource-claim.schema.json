{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resource-claim.schema.json",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^claim-[A-Za-z0-9._-]+$"
    },
    "workstream_id": {
      "type": "string",
      "pattern": "^ws-[A-Za-z0-9._-]+$"
    },
    "mode": {
      "enum": [
        "shared",
        "exclusive"
      ]
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "claim_id",
    "workstream_id",
    "mode",
    "resources",
    "reason"
  ],
  "additionalProperties": false
}
