{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "policy-rule.schema.json",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^atlas\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "evaluator": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "blocking",
        "approval",
        "warning"
      ]
    },
    "condition": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "remediation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "policy_id",
    "evaluator",
    "description",
    "severity",
    "condition",
    "evidence",
    "remediation"
  ],
  "additionalProperties": false
}
