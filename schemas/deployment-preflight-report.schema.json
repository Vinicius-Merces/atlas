{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Deployment Preflight Report",
  "type": "object",
  "properties": {
    "from_version": {
      "type": "string",
      "minLength": 1
    },
    "to_version": {
      "type": "string",
      "minLength": 1
    },
    "package": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "expected": {},
          "actual": {},
          "findings": {}
        },
        "required": [
          "check",
          "passed"
        ],
        "additionalProperties": false
      }
    },
    "outcome": {
      "enum": [
        "pending",
        "passed",
        "blocked"
      ]
    }
  },
  "required": [
    "from_version",
    "to_version",
    "package",
    "checks",
    "outcome"
  ],
  "additionalProperties": false
}
