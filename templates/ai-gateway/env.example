# ATLAS Free AI Pool
AI_ENABLED=true
AI_MODE=free_pool
AI_DEFAULT_PROFILE=demo-chat
AI_MAX_ATTEMPTS=3
AI_TOTAL_TIMEOUT_MS=20000
AI_ALLOW_PAID_FALLBACK=false

# Public application -> gateway controls belong in your application.
# Never expose provider keys to browser-side code.
AI_GATEWAY_BEARER_TOKEN=replace-with-a-server-side-secret-if-gateway-is-public

# Groq
GROQ_ENABLED=false
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=

# Ollama Cloud direct native API
OLLAMA_CLOUD_ENABLED=false
OLLAMA_CLOUD_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=

# Cloudflare Workers AI OpenAI-compatible endpoint.
# Replace <account-id> with the project account ID.
CLOUDFLARE_AI_ENABLED=false
CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
CLOUDFLARE_API_KEY=
CLOUDFLARE_AI_MODEL=

# OpenRouter. `openrouter/free` is suitable only for low-volume demos where
# variable model selection is acceptable.
OPENROUTER_ENABLED=false
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# GitHub Models. Use a token with `models:read` permission and verify the
# current free/prototyping limits before enabling it for a public demo.
GITHUB_MODELS_ENABLED=false
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=
GITHUB_MODELS_API_VERSION=2026-03-10

# Gemini OpenAI-compatible API. Free-tier eligibility, data-use terms and
# model availability are external state and must be reviewed per project.
GEMINI_ENABLED=false
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_MODEL=

# Remote Ollama behind your own authenticated TLS gateway/reverse proxy.
# Do not publish raw port 11434 directly to the internet.
OLLAMA_REMOTE_ENABLED=false
OLLAMA_REMOTE_BASE_URL=https://ollama.example.com/api
OLLAMA_REMOTE_GATEWAY_KEY=
OLLAMA_REMOTE_MODEL=

# Developer-machine Ollama. Local API authentication is normally not required.
OLLAMA_LOCAL_ENABLED=false
OLLAMA_LOCAL_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_LOCAL_GATEWAY_KEY=
OLLAMA_LOCAL_MODEL=
